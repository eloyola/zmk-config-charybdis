#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &charybdis_6col_layout; };
};

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║ CONFIGURATION                                                               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

&lt {
    quick-tap-ms = <175>;
    flavor = "balanced";
    tapping-term-ms = <200>;
};

// Layer definitions (must match charybdis_layers.h for trackball processors)
#define BASE    0
#define NAV     1
#define POINTER 2
#define MEDIA   3
#define NUM     4
#define SYM     5
#define FUN     6
#define SCROLL  7
#define SNIPING 8

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║ BEHAVIORS                                                                   ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

/ {
    behaviors {
        // Home row mods - Left hand
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55>;
            hold-trigger-on-release;
        };

        // Home row mods - Right hand
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52>;
            hold-trigger-on-release;
        };

        // Home Row Mods (Miryoku++)
        hrm_ctrl: hrm_ctrl {
        compatible = "zmk,behavior-hold-tap";
        label = "HRM_CTRL";
        #binding-cells = <2>;
        tapping-term-ms = <180>;
        quick-tap-ms = <120>;
        flavor = "hold-preferred";
        bindings = <&kp LCTRL>, <&kp A>;
        };

        hrm_alt: hrm_alt {
        compatible = "zmk,behavior-hold-tap";
        label = "HRM_ALT";
        #binding-cells = <2>;
        tapping-term-ms = <180>;
        quick-tap-ms = <120>;
        flavor = "hold-preferred";
        bindings = <&kp LALT>, <&kp S>;
        };

        hrm_gui: hrm_gui {
        compatible = "zmk,behavior-hold-tap";
        label = "HRM_GUI";
        #binding-cells = <2>;
        tapping-term-ms = <180>;
        quick-tap-ms = <120>;
        flavor = "hold-preferred";
        bindings = <&kp LGUI>, <&kp D>;
        };

        hrm_shift: hrm_shift {
        compatible = "zmk,behavior-hold-tap";
        label = "HRM_SHIFT";
        #binding-cells = <2>;
        tapping-term-ms = <180>;
        quick-tap-ms = <120>;
        flavor = "hold-preferred";
        bindings = <&kp LSHIFT>, <&kp F>;
        };

        hrm_shift_r: hrm_shift_r {
        compatible = "zmk,behavior-hold-tap";
        label = "HRM_SHIFT_R";
        #binding-cells = <2>;
        tapping-term-ms = <180>;
        quick-tap-ms = <120>;
        flavor = "hold-preferred";
        bindings = <&kp LSHIFT>, <&kp J>;
        };

        hrm_gui_r: hrm_gui_r {
        compatible = "zmk,behavior-hold-tap";
        label = "HRM_GUI_R";
        #binding-cells = <2>;
        tapping-term-ms = <180>;
        quick-tap-ms = <120>;
        flavor = "hold-preferred";
        bindings = <&kp LGUI>, <&kp K>;
        };

        hrm_alt_r: hrm_alt_r {
        compatible = "zmk,behavior-hold-tap";
        label = "HRM_ALT_R";
        #binding-cells = <2>;
        tapping-term-ms = <180>;
        quick-tap-ms = <120>;
        flavor = "hold-preferred";
        bindings = <&kp LALT>, <&kp L>;
        };

        hrm_ctrl_r: hrm_ctrl_r {
        compatible = "zmk,behavior-hold-tap";
        label = "HRM_CTRL_R";
        #binding-cells = <2>;
        tapping-term-ms = <180>;
        quick-tap-ms = <120>;
        flavor = "hold-preferred";
        bindings = <&kp LCTRL>, <&kp SEMI>;
        };
    };

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║ COMBOS                                                                      ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

    combos {
        compatible = "zmk,combos";

        // Studio Unlock - all three right thumb keys
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <53 54 55>;
            bindings = <&studio_unlock>;
        };

        combo_tab {
      timeout-ms = <30>;
      key-positions = <0 1>;
      bindings = <&kp TAB>;
    };

    combo_esc {
      timeout-ms = <30>;
      key-positions = <10 11>;
      bindings = <&kp ESC>;
    };

    combo_del {
      timeout-ms = <30>;
      key-positions = <8 9>;
      bindings = <&kp DELETE>;
    };

    combo_caps {
      timeout-ms = <30>;
      key-positions = <20 21>;
      bindings = <&kp CAPS>;
    };

    combo_backspace {
      timeout-ms = <30>;
      key-positions = <2 3>;
      bindings = <&kp BSPC>;
    };

    combo_enter {
      timeout-ms = <30>;
      key-positions = <7 8>;
      bindings = <&kp ENTER>;
    };

    combo_undo {
      timeout-ms = <30>;
      key-positions = <22 23>;
      bindings = <&kp LC(Z)>;
    };

    combo_redo {
      timeout-ms = <30>;
      key-positions = <27 28>;
      bindings = <&kp LC(Y)>;
    };

    combo_search {
      timeout-ms = <30>;
      key-positions = <16 17>;
      bindings = <&kp LG(SPACE)>;
    };
    };

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║ KEYMAP                                                                      ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

    keymap {
        compatible = "zmk,keymap";

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ BASE - Colemak-DH with home row mods (GACS)                          │
        // │ Unused keys (top row + outer columns) available for extras            │
        // └──────────────────────────────────────────────────────────────────────┘
        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1         &kp N2       &kp N3        &kp N4        &kp N5            &kp N6     &kp N7        &kp N8        &kp N9       &kp N0         &kp MINUS
&kp TAB    &kp Q          &kp W        &kp F         &kp P         &kp B             &kp J      &kp L         &kp U         &kp Y        &kp SQT        &kp BSLH
&kp LCTRL  &hml LGUI A    &hml LALT R  &hml LSHFT S  &hml LCTRL T  &kp G             &kp M      &hmr RCTRL N  &hmr RSHFT E  &hmr LALT I  &hmr RGUI O    &kp SEMI
&kp LSHFT  &kp Z          &kp X        &kp C         &kp D         &kp V             &kp K      &kp H         &kp COMMA     &kp DOT      &kp FSLH       &kp RSHFT
                                        &lt MEDIA ESC &lt NAV SPACE &lt POINTER TAB   &lt SYM RET  &lt NUM BSPC
                                                      &kp LALT      &lt FUN DEL       &lt POINTER TAB
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ NAV - Navigation + editing                                            │
        // └──────────────────────────────────────────────────────────────────────┘
        nav_layer {
            display-name = "Nav";
            bindings = <
&trans  &none     &none     &none      &none      &none       &none      &none      &none      &none      &none      &none
&none   &none     &none     &none      &none      &none       &kp K_REDO &kp K_PASTE &kp K_COPY &kp K_CUT &kp K_UNDO &none
&none   &kp LGUI  &kp LALT  &kp LSHFT  &kp LCTRL  &none       &caps_word &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none
&none   &none     &none     &none      &none      &none       &kp INS    &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none
                            &none      &none      &none       &kp RET    &kp BSPC
                                       &none      &none       &kp DEL
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ POINTER - Mouse buttons + trackball (scroll/snipe via held layers)    │
        // └──────────────────────────────────────────────────────────────────────┘
        pointer_layer {
            display-name = "Pointer";
            bindings = <
&trans  &none     &none     &none      &none      &none       &none      &none      &none      &none      &none      &none
&none   &none     &none     &none      &none      &none       &none      &none      &none      &none      &none      &none
&none   &kp LGUI  &kp LALT  &kp LSHFT  &kp LCTRL  &none       &none      &mkp LCLK  &mkp MCLK  &mkp RCLK  &none      &none
&none   &none     &none     &mo SCROLL &none      &mo SNIPING &none      &mkp MB4   &mkp MB5   &none      &none      &none
                            &mkp MCLK  &mkp LCLK  &mkp RCLK   &mkp LCLK  &mkp RCLK
                                       &none      &none        &mkp MCLK
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ MEDIA - Media controls + Bluetooth                                    │
        // └──────────────────────────────────────────────────────────────────────┘
        media_layer {
            display-name = "Media";
            bindings = <
&trans  &none     &none     &none      &none      &none       &none       &none        &none        &none        &none        &none
&none   &none     &none     &none      &none      &none       &none       &none        &none        &none        &none        &none
&none   &kp LGUI  &kp LALT  &kp LSHFT  &kp LCTRL  &none       &none       &kp C_PREV   &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT   &none
&none   &none     &none     &none      &none      &none       &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none
                            &none      &none      &none       &kp C_STOP  &kp C_PP
                                       &none      &none       &kp C_MUTE
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ NUM - Number pad                                                      │
        // └──────────────────────────────────────────────────────────────────────┘
        num_layer {
            display-name = "Num";
            bindings = <
&trans  &none      &none   &none    &none   &none       &none   &none      &none      &none     &none      &none
&none   &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT    &none   &none      &none      &none     &none      &none
&none   &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL   &none   &kp RCTRL  &kp RSHFT  &kp LALT  &kp RGUI   &none
&none   &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH    &none   &none      &none      &none     &none      &none
                           &kp DOT  &kp N0  &kp MINUS   &none   &none
                                    &none   &none       &none
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ SYM - Symbols                                                         │
        // └──────────────────────────────────────────────────────────────────────┘
        sym_layer {
            display-name = "Sym";
            bindings = <
&trans  &none      &none     &none      &none      &none       &none   &none      &none      &none     &none      &none
&none   &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC    &none   &none      &none      &none     &none      &none
&none   &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS    &none   &kp RCTRL  &kp RSHFT  &kp LALT  &kp RGUI   &none
&none   &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE    &none   &none      &none      &none     &none      &none
                             &kp LPAR  &kp RPAR   &kp UNDER   &none   &none
                                       &none      &none       &none
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ FUN - Function keys                                                   │
        // └──────────────────────────────────────────────────────────────────────┘
        fun_layer {
            display-name = "Fun";
            bindings = <
&trans  &none    &none   &none   &none      &none          &none   &none      &none      &none     &none      &none
&none   &kp F12  &kp F7  &kp F8  &kp F9     &kp PSCRN      &none   &none      &none      &none     &none      &none
&none   &kp F11  &kp F4  &kp F5  &kp F6     &kp SLCK       &none   &kp RCTRL  &kp RSHFT  &kp LALT  &kp RGUI   &none
&none   &kp F10  &kp F1  &kp F2  &kp F3     &kp PAUSE_BREAK &none  &none      &none      &none     &none      &none
                         &kp K_APP &kp SPACE &kp TAB        &none   &none
                                  &none     &none          &none
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ SCROLL - Trackball becomes scroll wheel                               │
        // └──────────────────────────────────────────────────────────────────────┘
        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ SNIPING - Trackball precision mode (reduced DPI)                      │
        // └──────────────────────────────────────────────────────────────────────┘
        sniping_layer {
            display-name = "Sniping";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
