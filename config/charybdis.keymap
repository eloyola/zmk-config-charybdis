#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &charybdis_6col_layout; };
};

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║ CONFIGURATION                                                               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

&lt {
    quick-tap-ms = <175>;
    flavor = "balanced";
    tapping-term-ms = <200>;
};

// Layer definitions (must match charybdis_layers.h for trackball processors)

#define BASE    0
#define NAV     1
#define POINTER 2
#define MEDIA   3
#define NUM     4
#define SYM     5
#define FUN     6
#define SCROLL  7
#define SNIPING 8

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║ BEHAVIORS                                                                   ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

/ {
    behaviors {
        // Home row mods - Left hand (for Shift on T)

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <200>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53 54>;
            hold-trigger-on-release;
        };

        // Home row mods - Right hand (for Shift on N)

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <200>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52 55>;
            hold-trigger-on-release;
        };

        // Left home row - relaxed timing for high-frequency keys (A, R, S)

        lhome_row: lhome_row {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <250>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53 54>;
            hold-trigger-on-release;
            label = "LHOME_ROW";
        };

        // Right home row - relaxed timing for high-frequency keys (E, I, O)

        rhome_row: rhome_row {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <250>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52 55>;
            hold-trigger-on-release;
            label = "RHOME_ROW";
        };

        skq: skq {
            compatible = "zmk,behavior-sticky-key";
            label = "SKQ";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1020>;
            quick-release;
            ignore-modifiers;
        };
    };

    // ╔══════════════════════════════════════════════════════════════════════════════╗
    // ║ COMBOS                                                                      ║
    // ╚══════════════════════════════════════════════════════════════════════════════╝

    combos {
        compatible = "zmk,combos";

        // Studio Unlock - all three right thumb keys

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <53 54 55>;
            bindings = <&studio_unlock>;
        };

        // C# operator combos
        // Row 3 (bottom): 36=Z 37=X 38=C 39=D 40=V | 41=K 42=H 43=, 44=. 45=/
        // Row 2 (home):   24=A 25=R 26=S 27=T 28=G | 29=M 30=N 31=E 32=I 33=O
        // => (fat arrow) - D + V (left bottom, index + inner)

        combo_fat_arrow {
            timeout-ms = <40>;
            key-positions = <39 40>;
            bindings = <&fat_arrow>;
        };

        // != (not equal) - H + , (right bottom, index + middle)

        combo_not_equal {
            timeout-ms = <40>;
            key-positions = <42 43>;
            bindings = <&not_equal>;
        };

        // == (double equal) - N + E (right home, index + middle)

        combo_dbl_equal {
            timeout-ms = <40>;
            key-positions = <30 31>;
            bindings = <&dbl_equal>;
        };

        // && (logical AND) - X + C (left bottom, ring + middle)

        combo_dbl_amp {
            timeout-ms = <40>;
            key-positions = <37 38>;
            bindings = <&dbl_amp>;
        };

        // || (logical OR) - , + . (right bottom, middle + ring)

        combo_dbl_pipe {
            timeout-ms = <40>;
            key-positions = <43 44>;
            bindings = <&dbl_pipe>;
        };

        // ?. (null-conditional) - . + / (right bottom, ring + pinky)

        combo_null_cond {
            timeout-ms = <40>;
            key-positions = <44 45>;
            bindings = <&null_cond>;
        };

        // ?? (null-coalescing) - I + O (right home, ring + pinky)

        combo_null_coal {
            timeout-ms = <40>;
            key-positions = <32 33>;
            bindings = <&null_coal>;
        };

        // // (line comment) - C + D (left bottom, middle + index)
        // CAPSLOCK - both home row shift keys (T + N)
    };

    // ╔══════════════════════════════════════════════════════════════════════════════╗
    // ║ KEYMAP                                                                      ║
    // ╚══════════════════════════════════════════════════════════════════════════════╝

    macros {
        pound: pound {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_3>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "POUND";
        };

        euro: euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_8>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "EURO";
        };

        // C# operator macros

        fat_arrow: fat_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "FAT_ARROW";
        };

        not_equal: not_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCL &kp EQUAL>;
            label = "NOT_EQUAL";
        };

        dbl_equal: dbl_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp EQUAL>;
            label = "DBL_EQUAL";
        };

        dbl_amp: dbl_amp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AMPS &kp AMPS>;
            label = "DBL_AMP";
        };

        dbl_pipe: dbl_pipe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PIPE &kp PIPE>;
            label = "DBL_PIPE";
        };

        null_cond: null_cond {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp QMARK &kp DOT>;
            label = "NULL_COND";
        };

        null_coal: null_coal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp QMARK &kp QMARK>;
            label = "NULL_COAL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ BASE - Colemak-DH with home row mods (GACS)                          │
        // │ Unused keys (top row + outer columns) available for extras            │
        // └──────────────────────────────────────────────────────────────────────┘

        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC     &kp N1             &kp N2             &kp N3              &kp N4              &kp N5        &kp N6        &kp N7              &kp N8              &kp N9             &kp N0             &kp MINUS
&kp TAB     &kp Q              &kp W              &kp F               &kp P               &kp B         &kp J         &kp L               &kp U               &kp Y              &kp SQT            &kp BACKSLASH
&skq LCTRL  &lhome_row LGUI A  &lhome_row LALT R  &lhome_row LCTRL S  &lhome_row LSHFT T  &kp G         &kp M         &rhome_row RSHFT N  &rhome_row RCTRL E  &rhome_row LALT I  &rhome_row RGUI O  &kp SEMI
&skq LSHFT  &kp Z              &kp X              &kp C               &kp D               &kp V         &kp K         &kp H               &kp COMMA           &kp DOT            &kp FSLH           &kp GRAVE
                                                  &kp BACKSPACE       &lt 2 SPACE         &lt 1 HOME    &lt 4 SPACE   &lt 6 RET
                                                                      &kp LWIN            &lt 3 END     &lt 5 DELETE
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ NAV - Navigation + editing                                            │
        // └──────────────────────────────────────────────────────────────────────┘

        nav_layer {
            display-name = "Nav";
            bindings = <
&trans  &none     &none     &none      &none       &none    &none       &none      &none      &none      &none      &none
&none   &none     &none     &none      &none       &none    &kp LC(Y)   &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp LC(Z)  &none
&none   &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none    &caps_word  &kp PG_UP  &kp UP     &kp PG_DN  &none      &none
&none   &none     &none     &none      &none       &none    &none       &kp LEFT   &kp DOWN   &kp RIGHT  &none      &none
                            &none      &none       &none    &kp HOME    &kp END
                                       &none       &none    &none
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ POINTER - Mouse buttons + trackball (scroll/snipe via held layers)    │
        // └──────────────────────────────────────────────────────────────────────┘

        pointer_layer {
            display-name = "Pointer";
            bindings = <
&trans  &none     &none      &none      &none       &none            &none      &none      &none                   &none              &none  &none
&none   &none     &none      &none      &none       &none            &mkp MB4   &mkp MB5   &kp LS(LG(LEFT_ARROW))  &kp LS(LG(RIGHT))  &none  &none
&none   &kp LGUI  &kp LALT   &kp LCTRL  &kp LSHIFT  &kp LS(LG(S))    &none      &none      &none                   &none              &none  &none
&none   &none     &mkp LCLK  &mkp MCLK  &mkp RCLK   &mo 7            &none      &mo 7      &kp RCTRL               &mo 8              &none  &none
                             &none      &none       &none            &mkp MCLK  &mkp RCLK
                                        &none       &none            &mkp LCLK
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ MEDIA - Media controls + Bluetooth                                    │
        // └──────────────────────────────────────────────────────────────────────┘

        media_layer {
            display-name = "Media";
            bindings = <
&trans  &none     &none     &none      &none       &none    &none       &none         &none         &none         &none         &none
&none   &none     &none     &none      &none       &none    &none       &none         &none         &none         &none         &none
&none   &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHIFT  &none    &none       &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &none
&none   &none     &none     &none      &none       &none    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none
                            &none      &none       &none    &kp C_STOP  &kp C_PP
                                       &none       &none    &kp C_MUTE
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ NUM - Number pad                                                      │
        // └──────────────────────────────────────────────────────────────────────┘

        num_layer {
            display-name = "Num";
            bindings = <
&trans  &none      &none   &none    &none   &none        &none  &none       &none      &none     &none     &none
&none   &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &none  &none       &none      &none     &none     &none
&none   &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &none  &kp RSHIFT  &kp RCTRL  &kp LALT  &kp RGUI  &none
&none   &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &none  &none       &none      &none     &none     &none
                           &kp DOT  &kp N0  &kp MINUS    &none  &none
                                    &none   &none        &none
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ SYM - C# optimized: brackets paired on index finger                   │
        // │ Top=braces, Home=parens, Bottom=angles. = on thumb for assignment.    │
        // └──────────────────────────────────────────────────────────────────────┘

        sym_layer {
            display-name = "Sym";
            bindings = <
&trans  &none      &none     &none      &none      &none        &none  &none       &none      &none     &none     &none
&none   &kp PIPE   &kp AMPS  &kp ASTRK  &kp LBRC   &kp RBRC     &none  &euro       &pound     &none     &none     &none
&none   &kp PLUS   &kp DLLR  &kp PRCNT  &kp LPAR   &kp RPAR     &none  &kp RSHIFT  &kp RCTRL  &kp LALT  &kp RGUI  &none
&none   &kp TILDE  &kp AT    &kp EXCL   &kp LT     &kp GT       &none  &none       &none      &none     &none     &none
                             &kp HASH   &kp EQUAL  &kp UNDER    &none  &none
                                        &none      &none        &none
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ FUN - Function keys                                                   │
        // └──────────────────────────────────────────────────────────────────────┘

        fun_layer {
            display-name = "Fun";
            bindings = <
&trans    &none    &none   &none   &none   &none              &none  &none       &none      &none     &none     &none
&none     &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN          &none  &none       &none      &none     &none     &none
&kp INS   &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK           &none  &kp RSHIFT  &kp RCTRL  &kp LALT  &kp RGUI  &none
&kp CAPS  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK    &none  &none       &none      &none     &none     &none
                           &none   &none   &none              &none  &none
                                   &none   &none              &none
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ SCROLL - Trackball becomes scroll wheel                               │
        // └──────────────────────────────────────────────────────────────────────┘

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        // ┌──────────────────────────────────────────────────────────────────────┐
        // │ SNIPING - Trackball precision mode (reduced DPI)                      │
        // └──────────────────────────────────────────────────────────────────────┘

        sniping_layer {
            display-name = "Sniping";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
