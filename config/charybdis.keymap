#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &charybdis_6col_layout; };
};

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

// Layer definitions

#define BASE 0
#define POINTER 1
#define RAISE 2
#define LOWER 3
#define SCROLL 4
#define SNIPING 5
#define CONFIG 6

/ {
    behaviors {
        // Hold-tap behavior for layer with tap-preferred

        blt: blt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };

        // Tap-dance for GUI/Ctrl+B

        gui_ctrlb: gui_ctrlb {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LGUI>, <&kp LC(B)>;
        };

        // Tap/hold Alt, double-tap Ctrl+Shift+Z

        lalt_dt: lalt_dt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LALT>, <&kp LC(LS(Z))>;
        };

        // Home row mods - Left hand

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53 54>; // Right side keys
            hold-trigger-on-release;
        };

        // Home row mods - Right hand

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52>; // Left side keys
            hold-trigger-on-release;
        };

        // RGB controls: default action, Shift = inverse action

        rgb_brt_mm: rgb_brt_mm {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_hue_mm: rgb_hue_mm {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_eff_mm: rgb_eff_mm {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF>, <&rgb_ug RGB_EFR>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rgb_pow_mm: rgb_pow_mm {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON>, <&rgb_ug RGB_OFF>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hold_tap: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HOLD_TAP";
            retro-tap;
        };

        htl: htl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HTL";
            retro-tap;
        };

        ht_gui: ht_gui {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;

            label = "HT_GUI";
            retro-tap;
        };

        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <250>;
        };
    };

    macros {
        // Ctrl+Alt+Cmd macro

        CAC: CAC {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LALT &kp LGUI &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LALT &kp LGUI>;
        };

        // Ctrl+Shift+Alt macro

        CSA: CSA {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHIFT &kp LALT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL &kp LSHIFT &kp LALT>;
        };

        // Ctrl+Alt macro

        CA: CA {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        // Hold Ctrl+Cmd+Left Click while key is pressed (for mouse drag window actions)

        ctrl_cmd_hold: ctrl_cmd_hold {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <10>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LGUI &mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK &kp LCTRL &kp LGUI>;
        };

        pound: pound {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;

            wait-ms = <0>;
            tap-ms = <10>;
        };

        euro: euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N8>,
                <&macro_release>,
                <&kp LALT>;

            wait-ms = <0>;
            tap-ms = <10>;
            label = "EURO";
        };
    };

    combos {
        compatible = "zmk,combos";
        timeout-ms = <20>;
        require-prior-idle-ms = <250>;

        // Studio Unlock Combo - all three right thumb keys

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <53 54 55>;
            bindings = <&studio_unlock>;
        };

        // Gaming layer toggle combo - keys 49, 55, 54

        combo_config_toggle {
            timeout-ms = <50>;
            key-positions = <49 55 54>;
            bindings = <&tog 6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        sensor-bindings = <&scroll_up_down>; 
        base_layer {
            label = "BASE";
            display-name = "Base";
            bindings = <
&kp ESC           &kp N1          &kp N2           &kp N3               &kp N4              &kp N5           &kp N6            &kp N7             &kp N8                &kp N9            &kp N0             &kp MINUS
&kp TAB           &kp Q           &kp W            &kp E                &kp R               &kp T            &kp Y             &kp U              &kp I                 &kp O             &kp P              &kp EQUAL
&kp LEFT_CONTROL  &ht_gui LWIN A  &htl LEFT_ALT S  &htl LEFT_CONTROL D  &hold_tap LSHIFT F  &kp G            &kp H             &hold_tap RSHFT J  &htl RIGHT_CONTROL K  &htl RIGHT_ALT L  &ht_gui RWIN SEMI  &kp SQT
&kp LSHFT         &lt 1 Z         &kp X            &kp C                &kp V               &kp B            &kp N             &kp M              &kp COMMA             &kp PERIOD        &kp SLASH          &kp LEFT_ALT
                                                   &kp LWIN             &kp DELETE          &blt 2 DELETE    &blt 3 BACKSPACE  &kp SPACE
                                                                        &kp SPACE           &kp BACKSPACE    &kp RET
            >;
        };

        pointer_layer {
            label = "POINTER";
            display-name = "Pointer";
            bindings = <
&kp F12  &kp F1    &kp F2        &kp F3            &kp F4     &kp F5      &kp F6         &kp F7      &kp F8             &kp F9         &kp F10   &kp F11
&trans   &none     &none         &none             &none      &none       &kp PAGE_UP    &none       &none              &none          &none     &mkp MB5
&trans   &kp LWIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LSHFT  &none       &kp PAGE_DOWN  &kp RSHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RWIN  &none
&trans   &none     &none         &none             &none      &none       &kp C_PP       &none       &none              &none          &none     &mkp MB4
                                 &kp LSHIFT        &mo 5      &mo 4       &mkp MB3       &mkp MB2
                                                   &mkp MB1   &mkp MB2    &mkp MB1
            >;
        };

        raise_layer {
            label = "RAISE";
            display-name = "Lower";
            bindings = <
&kp F12   &CAC F1  &CAC F2   &CAC F3   &CAC F4    &CAC F5              &CAC F6     &CAC F7  &CAC F8  &CAC F9  &CAC F10   &kp F11
&none     &none    &none     &kp UP    &none      &kp C_VOLUME_UP      &kp N7      &kp N8   &kp N9   &none    &kp PLUS   &kp MINUS
&none     &none    &kp LEFT  &kp DOWN  &kp RIGHT  &kp C_MUTE           &kp N4      &kp N5   &kp N6   &none    &kp ASTRK  &kp SLASH
&kp CAPS  &none    &none     &none     &none      &kp C_VOLUME_DOWN    &kp N1      &kp N2   &kp N3   &none    &kp EQUAL  &trans
                             &trans    &trans     &trans               &trans      &kp N0
                                       &trans     &trans               &kp PERIOD
            >;
        };

        lower_layer {
            label = "LOWER";
            display-name = "Symbols";
            bindings = <
&kp GRAVE  &trans     &trans             &trans           &trans        &trans                  &trans                 &trans      &trans         &trans            &trans     &trans
&none      &kp SQT    &kp DOUBLE_QUOTES  &kp EXCLAMATION  &kp QUESTION  &kp LEFT_BRACE          &kp RIGHT_BRACE        &kp COMMA   &kp SEMI       &kp COLON         &kp TILDE  &none
&trans     &kp MINUS  &kp PLUS           &kp ASTERISK     &kp PERCENT   &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &kp DOLLAR  &euro          &pound            &kp HASH   &kp AT
&trans     &kp CARET  &kp FSLH           &kp BACKSLASH    &kp PIPE      &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp UNDER   &kp LESS_THAN  &kp GREATER_THAN  &none      &trans
                                         &kp HOME         &trans        &kp END                 &trans                 &trans
                                                          &trans        &trans                  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        sniping_layer {
            label = "SNIPING";
            display-name = "Sniping";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        config_layer {
            label = "CONFIG";
            display-name = "ddf";
            bindings = <
&kp ESC  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5    &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0  &to 0
&none    &none            &none            &kp C_VOL_UP     &kp LG(MINUS)    &kp LG(EQUAL)      &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &none            &none
&none    &none            &kp C_PREV       &kp C_PP         &kp C_NEXT       &kp LG(N0)         &kp F23          &kp F24          &rgb_brt_mm      &rgb_hue_mm      &rgb_eff_mm      &bootloader
&none    &rgb_ug RGB_ON   &rgb_ug RGB_BRI  &kp C_VOL_DN     &rgb_ug RGB_EFF  &none              &bt BT_CLR       &bt BT_CLR_ALL   &rgb_pow_mm      &none            &none            &none
                                           &none            &none            &none              &none            &none
                                                            &none            &none              &kp RETURN
            >;
        };
    };
};
